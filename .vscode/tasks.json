{
  "version": "2.0.0",
  "tasks": [
    { "label": "Run Slot Car Duel", "type": "shell", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["run_app.py"], "isBackground": true },
    { "label": "Run tests", "type": "shell", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["-m", "pytest", "-q"], "group": "test" },
    { "label": "Build EXE", "type": "shell", "command": "powershell", "args": ["-ExecutionPolicy", "Bypass", "-File", "build_exe.ps1"], "group": "build" }
  ]
}
